        },
        {
          "Key": "PhysicsRootBone",
          "Source": {
            "Text": "Root bone: {0}"
          },
          "Translation": {
            "Text": "根骨骼：{0}"
          }
        },
        {
          "Key": "PhysicsSourceHelp",
          "Source": {
            "Text": "Choose Phy.json from any folder. Bone references are checked against the current preview mesh; no FModel folder or Skeleton JSON is required."
          },
          "Translation": {
            "Text": "选择任意目录中的 Phy.json 即可。使用当前预览模型校验所需骨骼，不需要 FModel 目录或 Skeleton JSON。"
          }
        },
        {
          "Key": "PhysicsSourceNode",
          "Source": {
            "Text": "Source node: {0}"
          },
          "Translation": {
            "Text": "来源节点：{0}"
