        },
        {
          "Key": "NeedPoseFolder",
          "Source": {
            "Text": "Choose the folder containing the POSE PSA files and PoseAsset JSON files."
          },
          "Translation": {
            "Text": "请选择包含 POSE PSA 和 PoseAsset JSON 文件的文件夹。"
          }
        },
        {
          "Key": "NoAnimGraph",
          "Source": {
            "Text": "The new blueprint has no AnimGraph."
          },
          "Translation": {
            "Text": "新蓝图缺少 AnimGraph。"
          }
        },
        {
