        },
        {
          "Key": "PhysicsTitle",
          "Source": {
            "Text": "Import Kawaii Physics"
          },
          "Translation": {
            "Text": "导入 Kawaii Physics"
          }
        },
        {
          "Key": "PoseButton",
          "Source": {
            "Text": "Pose Import"
          },
          "Translation": {
            "Text": "补偿导入"
          }
        },
        {
          "Key": "PoseFilterChanged",
          "Source": {
            "Text": "The import option changed. Read the groups again before creating assets."
          },
          "Translation": {
            "Text": "导入选项已改变，请重新读取分组后再创建资产。"
          }
        },
        {
          "Key": "PoseFolder",
          "Source": {
            "Text": "POSE folder"
