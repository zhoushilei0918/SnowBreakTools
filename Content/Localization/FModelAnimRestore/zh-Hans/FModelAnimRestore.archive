        {
          "Key": "PhysicsButton",
          "Source": {
            "Text": "Kawaii Import"
          },
          "Translation": {
            "Text": "物理导入"
          }
        },
        {
          "Key": "PhysicsHelp",
          "Source": {
            "Text": "Read a physics blueprint JSON, prepare the selected Kawaii Physics groups, then add them to this Animation Blueprint."
          },
          "Translation": {
            "Text": "读取物理蓝图 JSON，准备所选的 Kawaii Physics 组，然后添加到当前动画蓝图。"
          }
        },
        {
          "Key": "PhysicsJson",
          "Source": {
