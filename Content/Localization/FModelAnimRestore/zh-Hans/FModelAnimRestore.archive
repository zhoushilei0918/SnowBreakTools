        },
        {
          "Key": "NoOutputPose",
          "Source": {
            "Text": "The new blueprint has no Output Pose."
          },
          "Translation": {
            "Text": "新蓝图缺少 Output Pose。"
          }
        },
        {
          "Key": "NoPoseNames",
          "Source": {
            "Text": "The Pose Asset JSON has no pose names: "
