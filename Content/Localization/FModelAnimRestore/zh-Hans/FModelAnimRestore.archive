          "Translation": {
            "Text": "需要 FModel 导出的 JSON 数组: "
          }
        },
        {
          "Key": "GroupCount",
          "Source": {
            "Text": "Groups: {0} selected / {1} total"
          },
          "Translation": {
            "Text": "分组：已选择 {0} / 共 {1} 组"
          }
        },
        {
          "Key": "GroupsRead",
          "Source": {
            "Text": "Found {0} groups. Select one or more groups to import."
          },
          "Translation": {
            "Text": "找到 {0} 组。请选择一组或多组进行导入。"
          }
        },
        {
          "Key": "ImportPsaPoses",
          "Source": {
            "Text": "1. Import animations and create Pose Assets"
          },
          "Translation": {
            "Text": "1. 导入动画并创建 Pose Asset"
          }
        },
        {
          "Key": "ImportedPsa",
          "Source": {
            "Text": "Imported animation"
          },
          "Translation": {
            "Text": "导入的动画"
          }
        },
        {
          "Key": "IncompletePaste",
          "Source": {
            "Text": "Node import was incomplete. The added nodes were removed."
          },
          "Translation": {
            "Text": "节点导入不完整，已移除本次添加的节点。"
          }
        },
        {
          "Key": "InertializationNote",
          "Source": {
            "Text": "Inertialization and state-transition logic are outside static physics import and were not copied."
          },
          "Translation": {
            "Text": "物理蓝图的 Inertialization 不属于静态物理配置；还原链未复制状态切换逻辑。"
          }
        },
        {
          "Key": "InputNotFound",
          "Source": {
            "Text": "Cannot follow Root LinkIDs to the input pose: "
          },
          "Translation": {
            "Text": "无法从 Root 的 LinkID 还原到输入姿态: "
          }
        },
        {
          "Key": "InvalidAssetPackage",
          "Source": {
            "Text": "Enter a full asset package path without an extension, for example /Game/Character/POSE/MyPose: "
          },
          "Translation": {
            "Text": "请输入完整的资产包路径，不含扩展名，例如 /Game/Character/POSE/MyPose："
          }
        },
        {
          "Key": "InvalidDestination",
          "Source": {
            "Text": "The output folder must be a valid /Game/... path."
          },
          "Translation": {
            "Text": "输出目录必须是 /Game/...。"
          }
        },
        {
          "Key": "InvalidPhysicsArray",
          "Source": {
            "Text": "Invalid physics array format: "
