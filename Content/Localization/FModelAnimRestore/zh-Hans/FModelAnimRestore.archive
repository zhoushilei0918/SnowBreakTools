{
  "FormatVersion": 2,
  "Namespace": "",
  "Subnamespaces": [
    {
      "Namespace": "FModelAnimRestore",
      "Children": [
        {
          "Key": "AddNodes",
          "Source": {
            "Text": "2. Add nodes to this blueprint"
          },
          "Translation": {
            "Text": "2. 添加节点到当前蓝图"
          }
        },
        {
          "Key": "AddTransaction",
          "Source": {
            "Text": "Add FModel animation nodes"
          },
          "Translation": {
            "Text": "添加 FModel 动画节点"
          }
        },
        {
          "Key": "AnimationSkeletonMismatch",
          "Source": {
            "Text": "The preview animation must use the same Skeleton as the target mesh."
          },
          "Translation": {
            "Text": "参考动作必须使用目标模型的同一个 Skeleton。"
          }
        },
        {
          "Key": "BlueprintCreateFailed",
          "Source": {
            "Text": "Failed to create an Animation Blueprint."
          },
          "Translation": {
            "Text": "无法创建动画蓝图。"
          }
        },
        {
          "Key": "BlueprintSkeletonMismatch",
          "Source": {
            "Text": "The current Animation Blueprint and preview mesh must use the same Skeleton."
          },
          "Translation": {
            "Text": "当前动画蓝图与预览网格体必须使用同一个 Skeleton。"
          }
        },
        {
          "Key": "CannotPaste",
          "Source": {
            "Text": "The prepared nodes cannot be added to this graph."
          },
          "Translation": {
            "Text": "准备好的节点无法添加到此图表。"
          }
        },
        {
          "Key": "CannotReadJson",
          "Source": {
            "Text": "Cannot read JSON: "
          },
          "Translation": {
            "Text": "无法读取 JSON: "
          }
        },
        {
          "Key": "CannotSkipPoseNode",
          "Source": {
            "Text": "Cannot skip {0}: expected exactly one valid pose input. Branches, missing inputs and invalid LinkIDs cannot be bypassed."
          },
          "Translation": {
            "Text": "无法跳过 {0}：需要唯一且有效的姿态输入。不能跳过多输入分支、缺失输入或无效的 LinkID。"
          }
        },
        {
          "Key": "ChooseAbpp",
          "Source": {
            "Text": "Choose the character's abpp.json file."
          },
          "Translation": {
            "Text": "选择角色的 abpp.json 文件。"
          }
        },
        {
          "Key": "ChoosePhysicsJson",
          "Source": {
            "Text": "Choose the character's physics Animation Blueprint JSON exported by FModel."
          },
          "Translation": {
            "Text": "选择 FModel 导出的角色物理动画蓝图 JSON。"
          }
        },
        {
          "Key": "ChoosePoseFolder",
          "Source": {
            "Text": "Choose the folder containing the POSE PSA files and PoseAsset JSON files."
          },
          "Translation": {
            "Text": "选择包含 POSE PSA 和 PoseAsset JSON 文件的文件夹。"
          }
        },
        {
          "Key": "CompileFailed",
          "Source": {
            "Text": "The generated graph failed to compile. Check the Output Log."
          },
          "Translation": {
            "Text": "生成的动画蓝图编译失败，请查看 Output Log。"
          }
        },
        {
          "Key": "CompileWarnings",
          "Source": {
            "Text": "{0} compiled with {1} warnings. Check the Output Log."
          },
          "Translation": {
            "Text": "{0} 编译有 {1} 条警告，请查看 Output Log。"
          }
        },
        {
          "Key": "ContextChanged",
          "Source": {
            "Text": "The blueprint or preview mesh has changed. Prepare the import again in this blueprint's panel."
          },
          "Translation": {
            "Text": "蓝图或预览网格体已改变，请在此蓝图的面板中重新准备导入。"
          }
        },
        {
          "Key": "CreatedPoseAsset",
          "Source": {
            "Text": "Created Pose Asset"
          },
          "Translation": {
            "Text": "生成的 Pose Asset"
          }
        },
        {
          "Key": "CurrentBlueprint",
          "Source": {
            "Text": "Current blueprint"
          },
          "Translation": {
            "Text": "当前动画蓝图"
          }
        },
        {
          "Key": "DriveCurvesUnsupported",
          "Source": {
            "Text": "DrivePoses is supported; DriveCurves is not: "
          },
          "Translation": {
            "Text": "当前支持 DrivePoses，不支持 DriveCurves: "
          }
        },
        {
          "Key": "DuplicateOutputPath",
          "Source": {
            "Text": "Two outputs use the same asset path: "
